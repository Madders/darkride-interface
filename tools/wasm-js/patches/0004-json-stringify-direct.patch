+/* The keys of an object to write: the replacer's property list, or its
+   own string keys, of which the enumerable ones are marked, checked as
+   Object.keys checks them (EnumerableOwnProperties). */
+static int js_json_keys(JSContext *ctx, JSONStringifyContext *jsc,
+                        JSObject *p, JSPropertyEnum **ptab, uint32_t *plen)
+{
+    JSPropertyEnum *tab;
+    uint32_t i, len;
+    int64_t n;
+    int flags, res;
+    JSValue v;
+
+    *ptab = NULL;
+    *plen = 0;
+    if (JS_IsUndefined(jsc->property_list)) {
+        if (JS_GetOwnPropertyNamesInternal(ctx, &tab, &len, p,
+                                           JS_GPN_STRING_MASK))
+            return -1;
+        for (i = 0; i < len; i++) {
+            res = JS_GetOwnPropertyFlagsInternal(ctx, &flags, p, tab[i].atom);
+            if (res < 0) {
+                js_free_prop_enum(ctx, tab, len);
+                return -1;
+            }
+            tab[i].is_enumerable = res && (flags & JS_PROP_ENUMERABLE);
+        }
+    } else {
+        if (js_get_length64(ctx, &n, jsc->property_list))
+            return -1;
+        tab = js_malloc(ctx, sizeof(tab[0]) * max_int(n, 1));
+        if (!tab)
+            return -1;
+        for (len = 0; len < n; len++) {
+            v = JS_GetPropertyInt64(ctx, jsc->property_list, len);
+            if (JS_IsException(v))
+                goto fail;
+            tab[len].atom = JS_ValueToAtom(ctx, v);
+            JS_FreeValue(ctx, v);
+            if (tab[len].atom == JS_ATOM_NULL)
+                goto fail;
+            tab[len].is_enumerable = true;
+        }
+    }
+    *ptab = tab;
+    *plen = len;
+    return 0;
+ fail:
+    js_free_prop_enum(ctx, tab, len);
+    return -1;
+}
+
+/* Appends the JSON form of a property key (QuoteJSONString). */
+static int string_buffer_put_quoted_atom(JSContext *ctx, StringBuffer *b,
+                                         JSAtom atom)
+{
+    char buf[16];
+    size_t len;
+
+    if (__JS_AtomIsTaggedInt(atom)) {
+        buf[0] = '\"';
+        len = 1 + u32toa(buf + 1, __JS_AtomToUInt32(atom));
+        buf[len++] = '\"';
+        return string_buffer_write8(b, (const uint8_t *)buf, len);
+    }
+    return string_buffer_put_quoted(b, ctx->rt->atom_array[atom]);
+}
+
+/* Appends a finite number as ToString writes it. */
+static int string_buffer_put_number(StringBuffer *b, JSValueConst val)
+{
+    char buf[128];
+    JSDTOATempMem dtoa_mem;
+    double d;
+    int len;
+
+    if (JS_VALUE_GET_TAG(val) == JS_TAG_INT) {
+        len = i32toa(buf, JS_VALUE_GET_INT(val));
+    } else {
+        d = JS_VALUE_GET_FLOAT64(val);
+        if (js_dtoa_max_len(d, 10, 0, JS_DTOA_FORMAT_FREE) > sizeof(buf) - 1)
+            return string_buffer_concat_value(b, val);
+        len = js_dtoa(buf, d, 10, 0, JS_DTOA_FORMAT_FREE, &dtoa_mem);
+    }
+    return string_buffer_write8(b, (const uint8_t *)buf, len);
+}
