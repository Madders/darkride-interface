{
  "name": "hifi-deps",
  "version-string": "0.1.4-github-actions",
  "description": "Collected dependencies for High Fidelity applications",
  "dependencies": [
    "assimp",
    "brotli",
    "bullet3",
    "draco",
    "etc2comp",
    "glad",
    {
      "name": "mesa",
      "platform": "osx & x64"
    },
    "glm",
    {
      "name": "hifi-audio-codec",
      "platform": "!(osx & arm64) & !android"
    },
    "libsndfile",
    "nvtt",
    {
      "name": "openexr",
      "platform": "!android"
    },
    {
      "name": "openssl",
      "platform": "windows | osx | android"
    },
    "polyvox",
    "tbb",
    "vhacd",
    {
      "name": "webrtc",
      "platform": "!android & !(osx & arm64)"
    },
    "zlib"
  ]
}
