+// Darkride: whether a buffer view holds count elements of size bytes from offset, without overflowing
+inline bool SparseViewHolds(const BufferView &view, size_t offset, size_t count, size_t size) {
+    if (size == 0 || count > view.byteLength / size) {
+        return false;
+    }
+    return offset <= view.byteLength - count * size;
+}
