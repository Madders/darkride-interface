<@include gpu/Color.slh@>
<@include DefaultMaterials.slh@>
<@include render-utils/ShaderConstants.h@>
<@include CullFace.slh@>

<@if HIFI_USE_FORWARD or HIFI_USE_TRANSLUCENT@>
    <@if not HIFI_USE_UNLIT@>
        <@include gpu/Transform.slh@>
        <$declareStandardCameraTransform()$>
    <@else@>
        <@include LightingModel.slh@>
<@endif@>

    layout(location=0) out vec4 _fragColor0;
<@endif@>

<@if not HIFI_USE_UNLIT@>
    <@if HIFI_USE_FORWARD@>
        // the forward path lights in place: the sun's shadow cascades, and the point and spot lights of the
        // fragment's cluster with their shadows and cookies (the pass binds them for every lit pipeline)
        <@include GlobalLight.slh@>
        <@include Shadow.slh@>
        <@include LightLocal.slh@>
    <@endif@>
    <@if HIFI_USE_TRANSLUCENT@>
        <@include GlobalLight.slh@>
        <$declareEvalGlobalLightingAlphaBlended()$>
    <@elif HIFI_USE_FORWARD@>
        <$declareEvalSkyboxGlobalColor(_SCRIBE_NULL, HIFI_USE_FORWARD)$>
    <@else@>
        <@include DeferredBufferWrite.slh@>
    <@endif@>
<@else@>
    <@if not HIFI_USE_FORWARD@>
        <@if not HIFI_USE_TRANSLUCENT@>
            <@include DeferredBufferWrite.slh@>
        <@endif@>
    <@endif@>
<@endif@>

<@if HIFI_USE_FADE@>
    <@include Fade.slh@>
    <$declareFadeFragmentInstanced()$>
    <@def SIMPLE_POSITION_WS@>
<@endif@>

<@if not HIFI_USE_UNLIT@>
    <@if HIFI_USE_FORWARD or HIFI_USE_TRANSLUCENT@>
        layout(location=RENDER_UTILS_ATTR_POSITION_ES) in vec4 _positionES;
        // the world position too, for the shadows and local lights of the forward path (simple.slv sends it when
        // this is declared)
        <@def SIMPLE_POSITION_WS@>
    <@endif@>
<@endif@>
<@if SIMPLE_POSITION_WS@>
    layout(location=RENDER_UTILS_ATTR_POSITION_WS) in vec4 _positionWS;
<@endif@>
layout(location=RENDER_UTILS_ATTR_NORMAL_WS) in vec3 _normalWS;
layout(location=RENDER_UTILS_ATTR_COLOR) in vec4 _color;
layout(location=RENDER_UTILS_ATTR_TEXCOORD01) in vec4 _texCoord01;
#define _texCoord0 _texCoord01.xy
#define _texCoord1 _texCoord01.zw

LAYOUT(binding=0) uniform sampler2D simpleTexture;

void main(void) {
    vec4 texel = texture(simpleTexture, _texCoord0);
    texel = mix(texel, color_sRGBAToLinear(texel), float(_color.a <= 0.0));
    texel.rgb *= _color.rgb;
    texel.a *= abs(_color.a);

<@if HIFI_USE_FADE@>
    vec3 fadeEmissive;
    FadeObjectParams fadeParams;
    <$fetchFadeObjectParamsInstanced(fadeParams)$>
    applyFade(fadeParams, _positionWS.xyz, fadeEmissive);
<@endif@>

<@if not HIFI_USE_UNLIT@>
    <@if HIFI_USE_FORWARD or HIFI_USE_TRANSLUCENT@>
        float metallic = DEFAULT_METALLIC;
        vec3 fresnel = getFresnelF0(metallic, texel.rgb);

        TransformCamera cam = getTransformCamera();
        vec3 fragPosition = _positionES.xyz;
        vec3 fragNormalWS = evalSafeFrontOrBackFaceNormal(_normalWS, _positionWS.xyz);
    <@endif@>
    <@if HIFI_USE_FORWARD@>
        vec3 fragPositionWS = _positionWS.xyz;

        // the sun's shadow, from its cascades, when the frame has them (a count of 0 with shadows off, or none drawn)
        float shadowAttenuation = 1.0;
        if (getShadowCascadeCount() > 0) {
            shadowAttenuation = evalShadowAttenuation(getLightDirection(getKeyLight()), _positionWS, -_positionES.z, fragNormalWS);
        }

        // the point and spot lights of the cluster the fragment falls in, with their shadows and cookies; the
        // derivatives are for the cookies, taken here where control flow is uniform
        vec3 fragPositionWSDx = dFdx(fragPositionWS);
        vec3 fragPositionWSDy = dFdy(fragPositionWS);
        vec3 fragToEyeDirWS = normalize(cam._viewInverse[3].xyz - fragPositionWS);
        SurfaceData surfaceWS = initSurfaceData(DEFAULT_ROUGHNESS, fragNormalWS, fragToEyeDirWS);

        vec4 localLighting = vec4(0.0);
        <$fetchClusterInfo(_positionWS)$>;
        if (hasLocalLights(cluster)) {
            localLighting = evalLocalLighting(cluster, fragPositionWS, fragPositionWSDx, fragPositionWSDy, surfaceWS,
                                              metallic, fresnel, texel.rgb, 0.0,
                                              vec4(0), vec4(0), texel.a);
        }
    <@endif@>
<@endif@>

<@if not HIFI_USE_UNLIT@>
    <@if HIFI_USE_TRANSLUCENT@>
        <@if HIFI_USE_FORWARD@>
        _fragColor0 = vec4(evalGlobalLightingAlphaBlended(
            cam._viewInverse,
            shadowAttenuation,
            DEFAULT_OCCLUSION,
            fragPosition,
            fragNormalWS,
            texel.rgb,
            fresnel,
            metallic,
            DEFAULT_EMISSIVE
        <@if HIFI_USE_FADE@>
                + fadeEmissive
        <@endif@>
            ,
            surfaceWS, texel.a, localLighting.rgb),
            texel.a);
        <@else@>
        _fragColor0 = vec4(evalGlobalLightingAlphaBlended(
            cam._viewInverse,
            1.0,
            DEFAULT_OCCLUSION,
            fragPosition,
            fragNormalWS,
            texel.rgb,
            fresnel,
            metallic,
            DEFAULT_EMISSIVE
        <@if HIFI_USE_FADE@>
                + fadeEmissive
        <@endif@>
            ,
            DEFAULT_ROUGHNESS, texel.a),
            texel.a);
        <@endif@>
    <@elif HIFI_USE_FORWARD@>
        _fragColor0 = vec4(evalSkyboxGlobalColor(
            cam._viewInverse,
            shadowAttenuation,
            DEFAULT_OCCLUSION,
            fragPosition,
            texel.rgb,
            fresnel,
            metallic,
            DEFAULT_EMISSIVE
        <@if HIFI_USE_FADE@>
                + fadeEmissive
        <@endif@>
            ,
            surfaceWS,
            localLighting.rgb),
            texel.a);
    <@else@>
        packDeferredFragment(
            evalSafeFrontOrBackFaceNormal(_normalWS),
            1.0,
            texel.rgb,
            DEFAULT_ROUGHNESS,
            DEFAULT_METALLIC,
            DEFAULT_EMISSIVE
        <@if HIFI_USE_FADE@>
                + fadeEmissive
        <@endif@>
            ,
            DEFAULT_OCCLUSION,
            DEFAULT_SCATTERING);
    <@endif@>
<@else@>
    <@if HIFI_USE_FORWARD or HIFI_USE_TRANSLUCENT@>
        _fragColor0 = isUnlitEnabled() * vec4(texel.rgb
        <@if HIFI_USE_FADE@>
                + fadeEmissive
        <@endif@>
            , texel.a);
    <@else@>
        packDeferredFragmentUnlit(
            evalSafeFrontOrBackFaceNormal(_normalWS),
            1.0,
            texel.rgb
        <@if HIFI_USE_FADE@>
                + fadeEmissive
        <@endif@>
            );
    <@endif@>
<@endif@>
}
