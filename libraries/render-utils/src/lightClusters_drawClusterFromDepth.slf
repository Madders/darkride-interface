//
//  The lights the culling hands a fragment: the bits of its tile that are in its depth bin too, as a heat ramp
//  (green one, red twelve or more), the tiles' edges drawn in; what the light loop iterates before it clips each
//  light to its volume (lightClusters_drawClusterContent shows the count after that)

// Everything about deferred buffer
<@include DeferredBufferRead.slh@>

<@include LightClusterGrid.slh@>

<@include gpu/Color.slh@>
<$declareColorWheel()$>


layout(location=0) in vec2 varTexCoord0;
layout(location=0) out vec4 _fragColor;

void main(void) {

    // Grab the fragment data from the uv
    vec2 texCoord = varTexCoord0.st;

    vec4 fragEyePos = unpackDeferredPositionFromZeye(texCoord);
    vec4 fragWorldPos = getViewInverse() * fragEyePos;

    <$fetchClusterInfo(fragWorldPos)$>;
    int numLights = 0;
    if (hasLocalLights(cluster)) {
        for (int word = cluster.wordMin; word <= cluster.wordMax; word++) {
            numLights += bitCount(lightCluster_word(cluster, word));
        }
    }

    // the tile's edges
    int eye = int(lightClusterParams.counts.w > 0 && gl_FragCoord.x >= lightClusterParams.viewports[1].x);
    vec2 tilePos = fract((gl_FragCoord.xy - lightClusterParams.viewports[eye].xy) * lightClusterParams.tileInfo.xy);
    vec2 tileSize = 1.0 / lightClusterParams.tileInfo.xy;
    float edge = float(any(lessThan(tilePos * tileSize, vec2(1.0))));

    const float MAX_SHOWN = 12.0;
    vec3 color = colorRamp(1.0 - min(float(numLights), MAX_SHOWN) / MAX_SHOWN);
    _fragColor = vec4(mix(color, vec3(1.0), 0.5 * edge), max(float(numLights > 0) * 0.5, 0.35 * edge));
}
