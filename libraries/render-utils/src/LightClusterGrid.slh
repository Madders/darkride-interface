//
//  The frame's light culling, laid out as Unity URP's Forward+ (Drobot's tiles and z-bins, SIGGRAPH 2017): the point
//  and spot lights in view make a list, one bit each; the screen is cut into square tiles and the view's depth into
//  logarithmic bins; a tile's words hold the lights whose footprint covers it, a bin's the lights whose depth range
//  crosses it, and a bin's header the first and last light in it. A fragment finds its tile by its pixel and its bin
//  by its eye depth, ANDs the two words and shades the lights whose bits survive. LightClusters (render-utils) builds
//  it on the CPU every frame. The reflection probes in view are in the same list, their bits after the lights' from
//  the next whole word, with a second header a bin (ReflectionProbe.slh reads them).
!>
<@if not RENDER_LIGHT_CLUSTER_GRID_SLH@>
<@def RENDER_LIGHT_CLUSTER_GRID_SLH@>

<@include render-utils/ShaderConstants.h@>
<@include LightClusterGrid_shared.slh@>

// end of hybrid include

LAYOUT_STD140(binding=RENDER_UTILS_BUFFER_LIGHT_CLUSTER_PARAMS) uniform lightClusterParamsBuffer {
    LightClusterParams lightClusterParams;
};

LAYOUT_STD140(binding=RENDER_UTILS_BUFFER_LIGHT_CLUSTER_TILES) uniform lightClusterTilesBuffer {
    uvec4 _lightClusterTiles[LIGHT_CLUSTER_TILE_WORDS / 4];
};

LAYOUT_STD140(binding=RENDER_UTILS_BUFFER_LIGHT_CLUSTER_BINS) uniform lightClusterBinsBuffer {
    uvec4 _lightClusterBins[LIGHT_CLUSTER_BIN_WORDS / 4];
};

uint lightCluster_tileWord(int word) {
    return _lightClusterTiles[word >> 2][word & 3];
}

uint lightCluster_binWord(int word) {
    return _lightClusterBins[word >> 2][word & 3];
}

// The LightStage index of an entry of the list
int lightCluster_lightIndex(int entry) {
    return lightClusterParams.lightIndices[entry >> 2][entry & 3];
}

// Where a fragment reads: the first word of its tile, the first mask word of its bin, and the words to visit, from
// the bin's headers (the first and last light in the bin, then the first and last reflection probe; with none,
// wordMin > wordMax)
struct LightCluster {
    int tileWord;
    int binWord;
    int wordMin;
    int wordMax;
    int probeWordMin;
    int probeWordMax;
};

LightCluster fetchLightCluster(vec4 fragWorldPos, vec2 fragCoord) {
    LightCluster cluster;
    cluster.tileWord = 0;
    cluster.binWord = 2;
    cluster.wordMin = 1;
    cluster.wordMax = 0;
    cluster.probeWordMin = 1;
    cluster.probeWordMax = 0;
    if (lightClusterParams.counts.x <= 0 && lightClusterParams.probeCounts.y <= 0) {
        return cluster;
    }
    int wordsPerEntry = lightClusterParams.counts.y;

    // the tile, in the eye the pixel belongs to (a stereo frame draws its two eyes side by side)
    int eye = int(lightClusterParams.counts.w > 0 && fragCoord.x >= lightClusterParams.viewports[1].x);
    vec4 viewport = lightClusterParams.viewports[eye];
    ivec2 tileCount = ivec2(lightClusterParams.tileInfo.zw);
    ivec2 tile = clamp(ivec2((fragCoord - viewport.xy) * lightClusterParams.tileInfo.xy), ivec2(0), tileCount - 1);
    int tileIndex = eye * lightClusterParams.counts.z + tile.y * tileCount.x + tile.x;
    cluster.tileWord = tileIndex * wordsPerEntry;

    // the bin, by the eye depth
    float eyeDepth = -(lightClusterParams.worldToEye * fragWorldPos).z;
    int bin = clamp(int(floor(log2(max(eyeDepth, 1.0e-6)) * lightClusterParams.binInfo.x + lightClusterParams.binInfo.y)),
                    0, int(lightClusterParams.binInfo.z));
    int binBase = bin * (wordsPerEntry + 2);
    uint header = lightCluster_binWord(binBase);
    uint probeHeader = lightCluster_binWord(binBase + 1);
    cluster.binWord = binBase + 2;
    cluster.wordMin = int(header & 0xFFFFu) >> 5;
    cluster.wordMax = int(header >> 16) >> 5;
    cluster.probeWordMin = int(probeHeader & 0xFFFFu) >> 5;
    cluster.probeWordMax = int(probeHeader >> 16) >> 5;
    return cluster;
}

bool hasLocalLights(LightCluster cluster) {
    return cluster.wordMin <= cluster.wordMax;
}

bool hasReflectionProbes(LightCluster cluster) {
    return cluster.probeWordMin <= cluster.probeWordMax;
}

// One word of the list's bits: the lights of the fragment's tile that are in its bin too
uint lightCluster_word(LightCluster cluster, int word) {
    return lightCluster_tileWord(cluster.tileWord + word) & lightCluster_binWord(cluster.binWord + word);
}

<@func fetchClusterInfo(fragWorldPos)@>
    LightCluster cluster = fetchLightCluster(<$fragWorldPos$>, gl_FragCoord.xy);
<@endfunc@>

<@endif@>
