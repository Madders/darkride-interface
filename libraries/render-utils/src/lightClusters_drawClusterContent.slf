//
//  The lights that reach a fragment: of those its tile and depth bin hand it, the ones whose volume (and cone) holds
//  it, as a heat ramp (green one, red twelve or more); the count the light loop shades

// Everything about deferred buffer
<@include DeferredBufferRead.slh@>


<@include graphics/Light.slh@>
<$declareLightBuffer(256)$>

<@include LightClusterGrid.slh@>

<@include gpu/Color.slh@>
<$declareColorWheel()$>


layout(location=0) in vec2 varTexCoord0;
layout(location=0) out vec4 _fragColor;

void main(void) {

    // Grab the fragment data from the uv
    vec2 texCoord = varTexCoord0.st;

    vec4 fragEyePos = unpackDeferredPositionFromZeye(texCoord);
    vec4 fragWorldPos = getViewInverse() * fragEyePos;

    <$fetchClusterInfo(fragWorldPos)$>;
    if (!hasLocalLights(cluster)) {
        _fragColor = vec4(0.0);
        return;
    }

    int numLightTouching = 0;
    for (int word = cluster.wordMin; word <= cluster.wordMax; word++) {
        uint bits = lightCluster_word(cluster, word);
        while (bits != 0u) {
            int bit = findLSB(bits);
            bits &= bits - 1u;
            Light light = getLight(lightCluster_lightIndex((word << 5) + bit));

            // Clip againgst the light volume and Make the Light vector going from fragment to light center in world space
            vec4 fragLightVecLen2;
            vec4 fragLightDirLen;
            float cosSpotAngle;

            if (!lightVolume_clipFragToLightVolumePoint(light.volume, fragWorldPos.xyz, fragLightVecLen2)) {
                continue;
            }
            // Allright we re in the light sphere volume
            fragLightDirLen.w = length(fragLightVecLen2.xyz);
            fragLightDirLen.xyz = fragLightVecLen2.xyz / fragLightDirLen.w;

            // Check spot
            if (light_isSpot(light) && !lightVolume_clipFragToLightVolumeSpotSide(light.volume, fragLightDirLen, cosSpotAngle)) {
                continue;
            }

            numLightTouching++;
        }
    }

    const float MAX_SHOWN = 12.0;
    _fragColor = vec4(colorRamp(1.0 - min(float(numLightTouching), MAX_SHOWN) / MAX_SHOWN), float(numLightTouching > 0) * 0.5);
}
