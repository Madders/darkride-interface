<@include gpu/Config.slh@>
<$VERSION_HEADER$>
//  <$_SCRIBE_FILENAME$>
//  Generated on <$_SCRIBE_DATE$>
//
//  Draws one slice of a terrain's layer map arrays (TerrainLayerSet, RenderableTerrainEntityItem.h) from a layer's
//  maps as they arrive: the colour array's slice from its colour texture (sRGB both, so the slice holds the texture
//  as it is; white where the layer has none, which draws as its plain colour), the normal array's slice from its
//  normal map (x and y from the texture, as the engine stores normal maps, z made whole; flat where the layer has
//  none), or the mask array's slice from its roughness, occlusion and height maps, one channel each, a plain value
//  standing in for a map the layer does not have. Drawn over the unit quad, so the slice is the map scaled to the
//  array's size.
//
//  Distributed under the Apache License, Version 2.0.
//  See the accompanying file LICENSE or http://www.apache.org/licenses/LICENSE-2.0.html
//

<@include entities-renderer/ShaderConstants.h@>

layout(location=0) in vec2 varTexCoord0;
layout(location=0) out vec4 _fragColor0;

struct TerrainMapParams {
    ivec4 which;   // x: 0 the normal slice, 1 the mask slice, 2 the colour slice; y, z, w: whether the first, second and third source is bound
    vec4 plain;    // x: roughness, y: occlusion, z: height, written for a source that is not bound
};

LAYOUT_STD140(binding=ENTITIES_BUFFER_TERRAIN_MAPS) uniform terrainMapParamsBuffer {
    TerrainMapParams params;
};
LAYOUT(binding=0) uniform sampler2D source0;   // the colour texture, the normal map, or the roughness map
LAYOUT(binding=1) uniform sampler2D source1;   // the occlusion map
LAYOUT(binding=2) uniform sampler2D source2;   // the height map

void main(void) {
    vec2 uv = varTexCoord0;
    if (params.which.x == 2) {
        _fragColor0 = params.which.y != 0 ? texture(source0, uv) : vec4(1.0);
    } else if (params.which.x == 0) {
        vec3 normal = vec3(0.0, 0.0, 1.0);
        if (params.which.y != 0) {
            vec2 t = 2.0 * texture(source0, uv).rg - 1.0;
            normal = vec3(t, sqrt(max(0.0, 1.0 - dot(t, t))));
        }
        _fragColor0 = vec4(normal * 0.5 + 0.5, 1.0);
    } else {
        float roughness = params.which.y != 0 ? texture(source0, uv).r : params.plain.x;
        float occlusion = params.which.z != 0 ? texture(source1, uv).r : params.plain.y;
        float height = params.which.w != 0 ? texture(source2, uv).r : params.plain.z;
        _fragColor0 = vec4(roughness, occlusion, height, 1.0);
    }
}
