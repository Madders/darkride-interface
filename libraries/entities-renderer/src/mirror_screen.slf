<@include gpu/Config.slh@>
<$VERSION_HEADER$>
//  Generated on <$_SCRIBE_DATE$>
//
//  mirror_screen.slf
//  The glass of a screen-mode mirror (Mirrors.h): its picture was drawn from the viewer's reflection with the
//  main view's own projection, cropped to the region of the screen that holds the glass, so it lies pixel for
//  pixel under the glass; it is read by screen position within that region, flipped across (the reflected camera
//  was turned into a proper one), and written unlit, as light of its own: into the G-buffer, or straight to the
//  forward path's colour (the mirror view itself was rendered by whichever method the frame uses).
//
//  Distributed under the Apache License, Version 2.0.
//  See the accompanying file LICENSE or http://www.apache.org/licenses/LICENSE-2.0.html
//

<@include gpu/Transform.slh@>
<$declareStandardCameraTransform()$>
<@if HIFI_USE_FORWARD@>
    layout(location=0) out vec4 _fragColor0;
<@else@>
    <@include DeferredBufferWrite.slh@>
<@endif@>
<@include render-utils/ShaderConstants.h@>
<@include entities-renderer/ShaderConstants.h@>

LAYOUT(binding=ENTITIES_TEXTURE_MIRROR_PICTURE) uniform sampler2D mirrorPicture;

// the region of the main view the picture covers: its low corner (xy) and high corner (zw), in the view's
// normalized device coordinates
LAYOUT_STD140(binding=ENTITIES_BUFFER_MIRROR) uniform mirrorBuffer {
    vec4 mirrorRegion;
};

layout(location=RENDER_UTILS_ATTR_NORMAL_WS) in vec3 _normalWS;

void main(void) {
    TransformCamera cam = getTransformCamera();
    vec2 ndc = (gl_FragCoord.xy - cam._viewport.xy) / cam._viewport.zw * 2.0 - 1.0;
    vec2 uv = (ndc - mirrorRegion.xy) / (mirrorRegion.zw - mirrorRegion.xy);
    uv.x = 1.0 - uv.x;
    vec3 color = texture(mirrorPicture, uv).rgb;
<@if HIFI_USE_FORWARD@>
    _fragColor0 = vec4(color, 1.0);
<@else@>
    packDeferredFragmentUnlit(normalize(_normalWS), 1.0, color);
<@endif@>
}
