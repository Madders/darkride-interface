<@include gpu/Config.slh@>
<$VERSION_HEADER$>
//  <$_SCRIBE_FILENAME$>
//  Generated on <$_SCRIBE_DATE$>
//
//  A Terrain entity's chunk mesh (RenderableTerrainEntityItem): positions in voxel units relative to the chunk's
//  origin, the model transform placing the chunk in the world. The mesh is drawn without indices, three vertices to
//  a triangle, and the colour attribute carries the triangle's three voxel materials in its first three bytes and
//  which corner this vertex is in the fourth, so the fragment shader can blend the three materials across the
//  triangle. The model-space position goes through as well: it is the position within the chunk, in voxels, which
//  is where the chunk's paint map tile is read. Shadow passes draw these meshes with the standard shadow pipeline,
//  so there is no shadow variant.
//
//  Distributed under the Apache License, Version 2.0.
//  See the accompanying file LICENSE or http://www.apache.org/licenses/LICENSE-2.0.html
//

<@include gpu/Inputs.slh@>
<@include render-utils/ShaderConstants.h@>

<@include gpu/Transform.slh@>
<$declareStandardTransform()$>

<@if HIFI_USE_FORWARD@>
    layout(location=RENDER_UTILS_ATTR_POSITION_ES) out vec4 _positionES;
<@endif@>
layout(location=RENDER_UTILS_ATTR_POSITION_MS) out vec4 _positionMS;
layout(location=RENDER_UTILS_ATTR_POSITION_WS) out vec4 _positionWS;
layout(location=RENDER_UTILS_ATTR_NORMAL_WS) out vec3 _normalWS;
layout(location=RENDER_UTILS_ATTR_TEXCOORD01) flat out ivec3 _materials;   // the triangle's, the same at each corner
layout(location=RENDER_UTILS_ATTR_COLOR) out vec3 _weights;                 // this corner's unit weight: barycentric once interpolated

void main(void) {
    TransformCamera cam = getTransformCamera();
    TransformObject obj = getTransformObject();

<@if HIFI_USE_FORWARD@>
    <$transformModelToEyeAndClipPos(cam, obj, inPosition, _positionES, gl_Position)$>
<@else@>
    <$transformModelToClipPos(cam, obj, inPosition, gl_Position)$>
<@endif@>
    <$transformModelToWorldPos(obj, inPosition, _positionWS)$>
    <$transformModelToWorldDir(cam, obj, inNormal.xyz, _normalWS)$>
    _positionMS = inPosition;

    ivec4 packed = ivec4(inColor * 255.0 + 0.5);
    _materials = packed.xyz;
    _weights = vec3(packed.w == 0 ? 1.0 : 0.0, packed.w == 1 ? 1.0 : 0.0, packed.w == 2 ? 1.0 : 0.0);
}
