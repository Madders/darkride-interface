<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- the engine's graphics settings (SettingsFragment reads and changes them in the engine) -->
    <PreferenceCategory
        android:title="@string/settings_graphics"
        android:key="pref_key_graphics">
        <ListPreference
            android:key="graphics_preset"
            android:title="@string/graphics_quality"
            android:summary="%s"
            android:entries="@array/graphics_preset_names"
            android:entryValues="@array/graphics_preset_values"
            android:defaultValue="2" />
        <SwitchPreference
            android:key="graphics_shadows"
            android:title="@string/graphics_shadows"
            android:summary="@string/graphics_shadows_summary"
            android:defaultValue="false" />
        <SwitchPreference
            android:key="graphics_ambient_occlusion"
            android:title="@string/graphics_ambient_occlusion"
            android:summary="@string/graphics_ambient_occlusion_summary"
            android:defaultValue="false" />
        <ListPreference
            android:key="graphics_frame_rate"
            android:title="@string/graphics_frame_rate"
            android:summary="%s"
            android:entries="@array/graphics_frame_rate_names"
            android:entryValues="@array/graphics_frame_rate_values"
            android:defaultValue="2" />
        <ListPreference
            android:key="graphics_world_detail"
            android:title="@string/graphics_world_detail"
            android:summary="%s"
            android:entries="@array/graphics_world_detail_names"
            android:entryValues="@array/graphics_world_detail_values"
            android:defaultValue="1" />
        <ListPreference
            android:key="graphics_draw_distance"
            android:title="@string/graphics_draw_distance"
            android:summary="%s"
            android:entries="@array/graphics_draw_distance_names"
            android:entryValues="@array/graphics_draw_distance_values"
            android:defaultValue="16384" />
        <ListPreference
            android:key="graphics_resolution"
            android:title="@string/graphics_resolution"
            android:summary="%s"
            android:entries="@array/graphics_resolution_names"
            android:entryValues="@array/graphics_resolution_values"
            android:defaultValue="1.0" />
    </PreferenceCategory>
    <PreferenceCategory
        android:title="@string/settings_developer"
        android:key="pref_key_developer">
        <SwitchPreference
            android:key="aec"
            android:title="@string/AEC"
            android:summary="@string/acoustic_echo_cancellation"
            android:defaultValue="true" />
    </PreferenceCategory>
</PreferenceScreen>