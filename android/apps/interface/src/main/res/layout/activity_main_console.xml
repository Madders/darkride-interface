<?xml version="1.0" encoding="utf-8"?>
<!-- The main screen in the console layout (themes with "layout": "console", like Cyber HUD): a top bar with the
     section, status and profile, the screen, and the sections as tabs along the bottom. MainActivity fills the tabs and keeps the bars up to date. The toolbar and menu are there but hidden,
     for the rest of MainActivity -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/console_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/console_top_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/consoleBarHeight"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/consoleBarPadding"
        android:paddingEnd="@dimen/consoleBarPadding">

        <TextView
            android:id="@+id/console_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/console_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/consoleBarPadding"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/console_profile"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/console_profile_picture"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/default_profile_avatar" />

            <TextView
                android:id="@+id/console_profile_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>

    <View
        android:id="@+id/console_top_rule"
        android:layout_width="match_parent"
        android:layout_height="1dp" />

    <FrameLayout
        android:id="@+id/content_frame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <View
        android:id="@+id/console_bottom_rule"
        android:layout_width="match_parent"
        android:layout_height="1dp" />

    <LinearLayout
        android:id="@+id/console_tabs"
        android:layout_width="match_parent"
        android:layout_height="@dimen/consoleTabsHeight"
        android:orientation="horizontal" />

    <!-- for the rest of MainActivity: the toolbar it titles, and the menu it reads -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:headerLayout="@layout/navigation_header"
        app:menu="@menu/menu_navigation">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/logout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/logout" />
            <TextView
                android:id="@+id/policy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/privacyPolicy" />
        </LinearLayout>
    </com.google.android.material.navigation.NavigationView>
</LinearLayout>
